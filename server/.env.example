# VeilWorlds Server — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.

# Server
PORT=3001
HOST=127.0.0.1
APP_URL=https://veilworlds.com
NODE_ENV=production

# CORS
CORS_ORIGIN=https://veilworlds.com

# PostgreSQL
# Use a strong password and restrict DB user permissions in production.
DATABASE_URL=postgresql://veilworlds_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/veilworlds?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=booking@veilworlds.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
